{
  "info": {
    "_postman_id": "8e4c19a4-5d12-47d8-9b3a-7f4e2a10c905",
    "name": "Healthcare API Tests",
    "description": "Automated Postman test collection for Healthcare REST API - Doctors Route (Lab 5)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET /api/doctors",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response is an array\", function () {",
              "    pm.expect(pm.response.json()).to.be.an(\"array\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/api/doctors",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "doctors"]
        }
      },
      "response": []
    },
    {
      "name": "POST /api/doctors",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Created doctor has an id\", function () {",
              "    pm.expect(pm.response.json()).to.have.property(\"id\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Dr. Julie\",\n  \"specialty\": \"Neurology\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:3000/api/doctors",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "doctors"]
        }
      },
      "response": []
    },
    {
      "name": "POST /api/doctors (Missing field)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 400 Bad Request\", function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "",
              "pm.test(\"Error message is returned\", function () {",
              "    pm.expect(pm.response.json()).to.have.property(\"error\", \"Missing required fields\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Dr. Julie\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:3000/api/doctors",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "doctors"]
        }
