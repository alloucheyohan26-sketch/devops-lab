        {
          "name": "POST Create Reservation (/api/reservations)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Booking is created with status PENDING_PAYMENT', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('id');",
                  "    pm.expect(jsonData.locker_id).to.eql(4);",
                  "    pm.expect(jsonData.status).to.eql('PENDING_PAYMENT');",
                  "});",
                  "pm.test('Locker is held for 15 minutes (countdown)', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('hold_expires_at');",
                  "    pm.expect(jsonData.hold_remaining_seconds).to.be.within(1, 900);",
                  "    pm.collectionVariables.set('reservationId', jsonData.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"locker_id\": 4,\n  \"user_id\": 2,\n  \"start_time\": \"2025-03-05T08:00:00Z\",\n  \"end_time\": \"2025-03-05T12:00:00Z\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/api/reservations",
