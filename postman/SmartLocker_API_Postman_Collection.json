        {
          "name": "PUT Confirm Reservation after payment (/api/reservations/{{reservationId}})",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Paid booking is CONFIRMED and the countdown stops', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql('CONFIRMED');",
                  "    pm.expect(jsonData.hold_remaining_seconds).to.eql(null);",
                  "});"
